{
  "id": "mcp-flight-app",
  "name": "航班助手 Flight Assistant",
  "version": "1.0.0",
  "entry": "/",
  "mcpEndpoint": "/mcp",
  "transport": "streamable-http",
  "tools": [
    {
      "name": "search_flights",
      "title": "搜索航班",
      "input": ["from_city", "to_city", "date"],
      "output": "航班列表（flight cards）"
    },
    {
      "name": "get_flight",
      "title": "航班详情",
      "input": ["flight_id"],
      "output": "航班详情卡片"
    },
    {
      "name": "track_flight",
      "title": "实时追踪",
      "input": ["flight_id"],
      "output": "行程时间线"
    }
  ]
}
