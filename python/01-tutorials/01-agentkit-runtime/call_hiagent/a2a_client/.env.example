# 从 Hi Agent 的 A2A 服务渠道导出 Agent Card，保存为同目录的 remote_agentcard.json。
# 填写同一渠道的 API Key，服务通过 Apikey 请求头访问 Hi Agent。
HI_AGENT_API_KEY=

# 本地默认地址；容器通过 Dockerfile 设置 HOST=0.0.0.0。
HOST=127.0.0.1
PORT=8000
# 可选：Agent Card 对外公布的基址。云端使用完整 Runtime Endpoint。
# PUBLIC_BASE_URL=https://<gateway>/runtime/<runtime-id>
# 可选：使用其他位置的 Agent Card。
# REMOTE_AGENT_CARD_PATH=/path/to/remote_agentcard.json
