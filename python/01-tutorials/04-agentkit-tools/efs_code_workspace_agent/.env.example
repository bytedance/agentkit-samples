# AgentKit OpenAPI credentials.
VOLCENGINE_ACCESS_KEY=<your-access-key>
VOLCENGINE_SECRET_KEY=<your-secret-key>
VOLCENGINE_AGENTKIT_REGION=cn-beijing

# AgentKit Sandbox tool that supports the command execution APIs.
AGENTKIT_TOOL_ID=t-xxxxxxxx

# EFS filespace mounted into the created sandbox session.
AGENTKIT_EFS_FILESPACE_NAME=agentkit-code-agent-demo
# Optional second filespace for a negative isolation check.
AGENTKIT_EFS_ISOLATION_FILESPACE_NAME=
AGENTKIT_EFS_LOCAL_MOUNT_PATH=/mnt/efs/
AGENTKIT_EFS_READ_ONLY=false

# Optional demo tuning.
AGENTKIT_SESSION_TTL_SECONDS=28800
AGENTKIT_WAIT_TIMEOUT_SECONDS=600
AGENTKIT_ASYNC_WAIT_TIMEOUT_SECONDS=600
AGENTKIT_POLL_INTERVAL_SECONDS=5
AGENTKIT_ASYNC_POLL_INTERVAL_SECONDS=2

# Optional model override.
MODEL_AGENT_NAME=doubao-seed-evolving
