DEMO_MODE=auto
# Optional for the local UI to call a deployed Runtime.  Do not commit .env.
RUNTIME_ENDPOINT=
RUNTIME_API_KEY=
MODEL_AGENT_NAME=deepseek-v4-pro-260425
MODEL_AGENT_API_KEY=
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_REGION=

# Direct Docker observability. AgentKit-managed Runtime does not need this
# block because the platform supplies its own observability layer. Configure
# every signal endpoint explicitly; never derive credential-bearing URLs from
# another signal. Both grpc and http/protobuf are supported for metrics/logs.
DIRECT_CONTAINER_MODE=false
OTEL_SERVICE_NAME=hybrid-cloud-customer-service
OTEL_RESOURCE_ATTRIBUTES=apmplus.business_carrier=agentkit_runtime
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_PYTHON_LOG_LEVEL=INFO

# A2A: configure these only on the customer-service Runtime after deploying
# the separate data Agent.  Never place a deployed Runtime key in this file.
AGENT_APP_MODE=customer_service
A2A_DATA_AGENT_URL=
A2A_DATA_AGENT_CARD_URL=
A2A_DATA_AGENT_API_KEY=
A2A_DATA_AGENT_TIMEOUT_SECONDS=30

# Injected automatically after an AgentKit MCP toolset is associated with and
# published on the Runtime. Do not copy the underlying MCP service key here.
TOOL_MCP_ROUTER_URL=
TOOL_MCP_ROUTER_API_KEY=

# Used only by the separately deployed A2A data-agent Runtime.
# A2A_PUBLIC_URL=https://<data-agent-runtime-public-base>
