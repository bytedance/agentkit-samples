#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "${PROJECT_ROOT}/.venv/bin/agentkit" ]]; then
  export PATH="${PROJECT_ROOT}/.venv/bin:${PATH}"
fi

# 公共变量配置（从环境变量读取）
COMMON_HOST="${AGENTKIT_OPENAPI_HOST:?请先设置 AGENTKIT_OPENAPI_HOST（只填域名，不含协议和路径）}"
COMMON_SCHEME="${AGENTKIT_OPENAPI_SCHEME:-http}"
REGION="${VOLCENGINE_REGION:?请先设置 VOLCENGINE_REGION}"
AK="${VOLCENGINE_ACCESS_KEY:?请先设置 VOLCENGINE_ACCESS_KEY}"
SK="${VOLCENGINE_SECRET_KEY:?请先设置 VOLCENGINE_SECRET_KEY}"

if [[ "${COMMON_HOST}" =~ ^https?:// || "${COMMON_HOST}" == */* || "${COMMON_HOST}" =~ [[:space:]] ]]; then
  echo "AGENTKIT_OPENAPI_HOST 只能填写不含协议、路径和空白字符的域名。" >&2
  exit 1
fi

if [[ "${COMMON_SCHEME}" != "http" && "${COMMON_SCHEME}" != "https" ]]; then
  echo "AGENTKIT_OPENAPI_SCHEME 只能是 http 或 https。" >&2
  exit 1
fi

if [[ "${COMMON_SCHEME}" == "http" ]]; then
  echo "WARNING: 当前使用 HTTP，仅适用于明确交付的内网/POC TOP 入口；正式环境必须使用 HTTPS。" >&2
fi

echo "Checking ${COMMON_SCHEME}://${COMMON_HOST}/ping ..."
curl --fail --silent --show-error \
  --connect-timeout 10 \
  --max-time 20 \
  "${COMMON_SCHEME}://${COMMON_HOST}/ping" |
  grep --quiet '"pong"' || {
    echo "OpenAPI 预检失败：请先修复域名解析、网络或所选协议的证书/入口配置，再配置 CLI。" >&2
    exit 1
  }

set_config() {
  local key="$1"
  local value="$2"
  agentkit config --global --set "${key}=${value}"
}

set_secret_config() {
  local key="$1"
  local value="$2"
  agentkit config --global --set "${key}=${value}" >/dev/null
  echo "Global secret config updated: ${key}=<redacted>"
}

set_config "services.agentkit.host" "${COMMON_HOST}"
set_config "services.agentkit.scheme" "${COMMON_SCHEME}"
set_config "services.iam.host" "${COMMON_HOST}"
set_config "services.iam.scheme" "${COMMON_SCHEME}"
set_config "services.cr.host" "${COMMON_HOST}"
set_config "services.cr.scheme" "${COMMON_SCHEME}"

set_config "cr.instance_name" "cr-basic"
set_config "cr.namespace_name" "agentkit"

set_secret_config "volcengine.access_key" "${AK}"
set_secret_config "volcengine.secret_key" "${SK}"
set_config "region" "${REGION}"

set_config "defaults.launch_type" "hybrid"
set_config "defaults.preflight_mode" "skip"
set_config "defaults.cr_public_endpoint_check" "false"
set_config "defaults.iam_role_policies" "ServiceRoleForAgentKit"
set_config "defaults.disable_region_strict_restrictions" "true"

echo "AgentKit CLI configuration completed for ${COMMON_HOST}."
