# OpenAI-compatible Ark model settings used by the Strands OpenAIModel.
# Set MODEL_AGENT_NAME and MODEL_AGENT_API_KEY before running agent.py or --verify.
MODEL_AGENT_NAME=
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/responses
MODEL_AGENT_API_KEY=

# AgentKit CLI credentials for `agentkit migrate` and `agentkit deploy`.
# The native Bedrock AgentCore business agent in agent.py does not read these values.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
