# OpenAI-compatible Ark model setting. Local `python agent.py` does not call the model.
MODEL_AGENT_NAME=
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/responses
MODEL_AGENT_API_KEY=

# AgentKit CLI credentials for `agentkit migrate` and `agentkit deploy`.
# The native Google ADK business agent in agent.py does not read these values.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
