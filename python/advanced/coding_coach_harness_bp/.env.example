# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# Who reads this file:
#  - The standalone `agentkit` CLI reads BYTEPLUS_ACCESS_KEY / BYTEPLUS_SECRET_KEY
#    (and BYTEPLUS_REGION) from the `.env` in the directory you run it from, so
#    `agentkit harness deploy`, `agentkit skill ...`, `agentkit sandbox ...` and
#    `scripts/demo_session.sh` work without exporting anything. An AK/SK already
#    exported in the shell wins over `.env`.
#  - `scripts/publish_skill.py` loads this file itself (python-dotenv); values in
#    `.env` take precedence over variables exported in the shell.
#  - `agentkit harness dev` (local server) reads MODEL_AGENT_API_KEY /
#    MODEL_AGENT_API_BASE and the optional AGENTKIT_TOOL_ID from the environment,
#    so run `set -a && source .env && set +a` before it.
#
# Nothing in `.env` is forwarded to the deployed runtime: the runtime gets its
# model access from its IAM role, and the sandbox tool is bound with
# `agentkit runtime update code-coach --tool-id t-...` (see the README).

# --- Required -----------------------------------------------------------------
# Both are mandatory for the BytePlus copy of this sample: AGENTKIT_CLOUD_PROVIDER
# is read by the agentkit SDK, CLOUD_PROVIDER by veADK (TOS/Ark endpoints and the
# BYTEPLUS_* -> VOLCENGINE_* credential mapping used by publish_skill.py and
# `agentkit harness dev`).
AGENTKIT_CLOUD_PROVIDER=byteplus
CLOUD_PROVIDER=byteplus

# BytePlus access key / secret key (IAM user with AgentKitFullAccess + TOSFullAccess)
BYTEPLUS_ACCESS_KEY={{your_access_key}}
BYTEPLUS_SECRET_KEY={{your_secret_key}}
BYTEPLUS_REGION=ap-southeast-1

# Skill Space to publish the code-coach skill into (`agentkit skill spaces`).
# Used as the default for `scripts/publish_skill.py --space`.
SKILL_SPACE_ID={{your_skill_space_id}}

# --- Local dev only (`agentkit harness dev`) ----------------------------------
# BytePlus ModelArk API key + endpoint. The cloud runtime does not need these.
MODEL_AGENT_API_KEY={{your_model_agent_api_key}}
MODEL_AGENT_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3/
# CodeEnv sandbox tool id (t-...); lets run_code work in the local server
# AGENTKIT_TOOL_ID={{your_sandbox_tool_id}}
# Combined CA bundle if you are behind a TLS-inspecting corporate gateway
# SSL_CERT_FILE=/path/to/combined-ca.pem
