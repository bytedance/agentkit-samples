# Copy this file to `.env` for local runs. Keep real secrets in your ignored
# `.env`, shell environment, AgentKit console injection, or credential hosting.

# --- Volcengine credentials ---
# Set AK/SK only for local CLI or SDK calls that require them. AgentKit cloud
# runtime should receive credentials through runtime IAM or secret injection.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# VOLCENGINE_REGION=cn-beijing

# --- Agent reasoning model (optional for cloud runtime) ---
# Do not leave a fake non-empty MODEL_AGENT_API_KEY in deployed samples.
# MODEL_AGENT_PROVIDER=openai
# MODEL_AGENT_NAME=doubao-seed-1-6-250615
# MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
# MODEL_AGENT_API_KEY=

# --- User Pool / Runtime JWT auth ---
USERPOOL_ID=
USERPOOL_CLIENT_ID=
# OIDC discovery URL for Runtime custom_jwt auth.
# Example shape:
# https://userpool-<USERPOOL_ID>.userpool.auth.id.cn-beijing.volces.com/.well-known/openid-configuration
USERPOOL_DISCOVERY_URL=
# Optional separate M2M client id used by backend tests.
USERPOOL_M2M_CLIENT_ID=

# --- Local Web UI OAuth2 login ---
# `app.py` starts an integrated local VeADK Web UI and uses
# http://127.0.0.1:8000/oauth2/callback by default.
HOST=127.0.0.1
PORT=8000
OAUTH2_PROVIDER_LABEL=VeIdentity
OAUTH2_REDIRECT_URI=http://127.0.0.1:8000/oauth2/callback
# Set this only when you intentionally expose the local login UI outside the
# loopback interface.
LOCAL_UI_ALLOW_REMOTE=false
OAUTH2_ISSUER_URI=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPES="openid profile email"
FLASK_SECRET_KEY=

# --- Local token helper ---
OAUTH2_TESTAPP_REDIRECT_URI=http://127.0.0.1:8082/callback

# --- Local cloud Runtime client ---
CLOUD_CLIENT_REDIRECT_URI=http://127.0.0.1:8083/oauth2/callback
AGENT_RUNTIME_URL=
CLOUD_AGENT_APP_NAME=userpool_sandbox_mcp_authz
CLOUD_AGENT_DEFAULT_PROMPT="List the MCP tools available in the Skills Sandbox."
# Default uses AgentkitAgentServerApp's /invoke compatibility route because it
# creates the Runtime session if needed. Use run_sse to force native ADK SSE.
CLOUD_AGENT_CALL_PATH=invoke
CLOUD_CLIENT_TIMEOUT_SECONDS=300

# --- Skills Sandbox binding ---
# Primary ToolId used by AgentKit Runtime. The compatibility alias is read by
# VeADK execute_skills; set both to the same Skills Sandbox ToolId unless your
# runtime injects the alias for you.
AGENTKIT_TOOL_ID=
AGENTKIT_TOOL_ID_SKILLS=
SKILL_SPACE_ID=

# --- Skills Sandbox MCP operation prompt ---
# Skills Sandbox owns MCP_SERVICE_URL, MCP outbound auth, and any gateway token
# exchange. Runtime only delegates through execute_skills and forwards
# credential key inbound_auth to Skills Sandbox.
SKILL_SANDBOX_MCP_PROMPT="You are running inside AgentKit Skills Sandbox for a User Pool identity experiment. Use the MCP tools configured in this Skills Sandbox to satisfy the user request: {user_request}. Do not reveal access tokens, TIP tokens, request headers, API keys, endpoint secrets, or internal credential values."
